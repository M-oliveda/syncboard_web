{
  "name": "syncboard-web",
  "version": "0.1.0",
  "description": "SyncBoard Web — React 19 + Vite + TypeScript frontend for a real-time collaborative Kanban board",
  "license": "GPL-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/M-oliveda/syncboard_web.git"
  },
  "bugs": {
    "url": "https://github.com/M-oliveda/syncboard_web/issues"
  },
  "homepage": "https://github.com/M-oliveda/syncboard_web#readme",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:staging": "playwright test --config=playwright.staging.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "prepare": "husky || true"
  },
